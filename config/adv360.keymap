#include <behaviors.dtsi>
#include <dt-bindings/zmk/backlight.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/rgb.h>

/ {
    behaviors {
        #include "macros.dtsi"
      #include "version.dtsi"
      #ifndef VERSION_MACRO

        macro_ver: macro_ver {
            compatible = "zmk,behavior-macro";
            label = "macro_version";
            #binding-cells = <0>;
            bindings = <&kp RET>;
        };

        vim_o: vim_o {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp END &kp ENTER>;
            label = "VIM_O";
        };

        vim_d: vim_d {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp HOME &kp LS(END) &kp LC(X)>;
            label = "VIM_D";
        };

        vim_z: vim_z {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LC(S) &kp LA(F4)>;
            label = "VIM_Z";
        };

        #endif

        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick_tap_ms = <175>;
            flavor = "tap-preferred";
            bindings = <&kp>, <&kp>;
        };
    };

    macros {
    };

    keymap {
        compatible = "zmk,keymap";

        default_layer {
            bindings = <
&kp EQUAL  &kp N1    &kp N2   &kp N3    &kp N4     &kp N5  &tog 1                                                                  &mo 3      &kp N6  &kp N7          &kp N8        &kp N9         &kp N0       &kp MINUS
&kp TAB    &kp Q     &kp W    &kp E     &kp R      &kp T   &none                                                                   &none      &kp Y   &kp U           &kp I         &kp O          &kp P        &kp BSLH
&kp ESC    &kp A     &kp S    &kp D     &kp F      &kp G   &none     &kp LEFT_WIN  &kp PRINTSCREEN        &kp LGUI      &kp RCTRL  &none      &kp H   &kp J           &kp K         &kp L          &kp SEMI     &mo 1
&kp LSHFT  &kp Z     &kp X    &kp C     &kp V      &kp B                           &kp RIGHT_CONTROL      &none                               &kp N   &kp M           &kp COMMA     &kp DOT        &kp FSLH     &kp RSHFT
&mo 2      &kp HOME  &kp END  &kp LEFT  &kp RIGHT          &kp BSPC  &kp DEL       &mo 1                  &kp LEFT_ALT  &kp ENTER  &kp SPACE          &kp DOWN_ARROW  &kp UP_ARROW  &kp PAGE_DOWN  &kp PAGE_UP  &mo 2
            >;
        };

        keypad {
            bindings = <
&kp K_MUTE  &kp C_VOLUME_DOWN  &kp C_REWIND       &kp K_PLAY_PAUSE      &kp C_NEXT             &kp C_VOLUME_UP  &trans                                          &none         &none     &none         &none         &none         &none      &kp MINUS
&none       &none              &kp UNDERSCORE     &kp SQT               &kp DOUBLE_QUOTES      &kp GRAVE        &none                                           &none         &kp Y     &kp NUMBER_7  &kp NUMBER_8  &kp NUMBER_9  &kp PLUS   &kp BSLH
&kp MINUS   &kp LEFT_BRACKET   &kp RIGHT_BRACKET  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp TILDE        &none     &none    &none      &none  &kp RCTRL  &none         &kp HASH  &kp NUMBER_4  &kp NUMBER_5  &kp NUMBER_6  &kp MINUS  &mo 1
&kp LSHFT   &kp LESS_THAN      &kp GREATER_THAN   &kp LEFT_BRACE        &kp RIGHT_BRACE        &none                               &none      &none                           &kp N     &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3  &kp EQUAL  &kp RSHFT
&mo 2       &kp GRAVE          &none              &kp LEFT              &kp RIGHT                               &kp BSPC  &kp DEL  &mo 1      &none  &kp ENTER  &kp NUMBER_0            &kp UP        &kp DOWN      &none         &none      &mo 2
            >;
        };

        fn_and_vim {
            bindings = <
&kp F12         &kp F1           &kp F2               &kp F3               &kp F4               &kp F5        &none                                                             &none            &kp F6          &kp F7          &kp F8        &kp F9     &kp F10    &kp F11
&kp TAB         &kp LA(F4)       &kp LC(RIGHT_ARROW)  &kp LC(RIGHT_ARROW)  &kp LC(Y)            &kp LC(T)     &none                                                             &none            &kp LC(C)       &kp LC(Z)       &kp LEFT      &vim_o     &kp LC(V)  &trans
&kp ESCAPE      &kp RIGHT_ARROW  &kp LC(H)            &vim_d               &none                &kp LC(HOME)  &none     &trans  &trans                &trans  &kp LEFT_CONTROL  &none            &kp LEFT_ARROW  &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT  &kp LC(S)  &trans
&kp LEFT_SHIFT  &vim_z           &kp DELETE           &kp LC(DEL)          &kp LS(RIGHT_ARROW)  &trans                          &kp LEFT_CONTROL      &trans                                     &trans          &trans          &none         &kp LC(V)  &kp LC(F)  &kp RIGHT_SHIFT
&trans          &kp HOME         &kp END              &kp LEFT_ARROW       &kp RIGHT_ARROW                    &kp LEFT  &trans  &trans                &trans  &trans            &kp RIGHT_ARROW                  &kp DOWN        &kp UP_ARROW  &trans     &trans     &trans
            >;
        };

        mod {
            bindings = <
&none  &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4  &none                                                  &trans                  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &bootloader                                            &bootloader             &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none         &none         &none        &none  &none      &bt BT_CLR  &none       &rgb_ug RGB_MEFS_CMD 5  &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &macro_ver    &none                             &none      &none                                           &none  &none       &none       &none  &none  &none
&none  &none         &none         &none         &none                       &none        &none  &none      &none       &bl BL_TOG  &rgb_ug RGB_TOG                &bl BL_INC  &bl BL_DEC  &none  &none  &none
            >;
        };
    };
};
